# Required: OpenAI API key (the only input needed to run the agent)
OPENAI_API_KEY=sk-...

# Optional but recommended: enables Arize tracing.
# Get both from https://app.arize.com (Settings -> Space API Keys).
# Space ID also appears in the Arize URL: /spaces/{SPACE_ID}/...
ARIZE_SPACE_ID=U3BhY2U6...
ARIZE_API_KEY=ak-...
